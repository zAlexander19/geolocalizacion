# ===== CONFIGURACIÓN DEL SERVIDOR =====
PORT=4000
NODE_ENV=production

# ===== CONFIGURACIÓN DE LA BASE DE DATOS =====
DB_HOST=172.19.82.207
DB_PORT=5432
DB_NAME=geolocalizacion
DB_USER=postgres
DB_PASSWORD=AqN65xZ31
DB_SSL=true

# ===== CONFIGURACIÓN DE CORS =====
# Dominio del frontend que puede acceder a la API
ALLOWED_ORIGINS=https://geocampus.unap.cl,http://geocampus.unap.cl

# ===== CONFIGURACIÓN DE JWT =====
# IMPORTANTE: Cambiar este secreto por uno generado de forma segura
# Puedes generar uno con: openssl rand -base64 32
JWT_SECRET=CAMBIAR_ESTE_SECRETO_POR_UNO_SEGURO_EN_PRODUCCION

# ===== CONFIGURACIÓN DE CLOUDINARY (Opcional) =====
# Si usas Cloudinary para almacenar imágenes, descomentar y configurar:
# CLOUDINARY_CLOUD_NAME=tu_cloud_name
# CLOUDINARY_API_KEY=tu_api_key
# CLOUDINARY_API_SECRET=tu_api_secret

# ===== CONFIGURACIÓN DE LOGS =====
LOG_LEVEL=info
